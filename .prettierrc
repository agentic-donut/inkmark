{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"bracketSpacing": false,
	"plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
	"tailwindStylesheet": "./src/lib/ui/styles/app.css",
	"overrides": [{"files": "*.svelte", "options": {"parser": "svelte"}}]
}
