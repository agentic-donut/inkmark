{
	"name": "inkmark",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:lan": "vite dev --host 0.0.0.0",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"test": "vitest run",
		"test:watch": "vitest",
		"i18n:compile": "node scripts/paraglide-compile.mjs",
		"check": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "npm run i18n:compile && eslint .",
		"format": "prettier --write .",
		"setup:hooks": "git config core.hooksPath .githooks",
		"deploy": ".githooks/deploy-main --now",
		"deploy:log": "scripts/deploy-log.sh",
		"deploy:install": "scripts/deploy-install.sh",
		"review:templates": "node scripts/review-templates.mjs",
		"review:rounds": "node scripts/review-rounds.mjs"
	},
	"dependencies": {
		"jszip": "^3.10.1",
		"opentype.js": "^1.3.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.27.0",
		"@inlang/plugin-message-format": "^4.5.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	}
}
